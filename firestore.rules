rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organisers: signed-in accounts whose user ID has a document in /admins (full control).
    // Volunteers: signed-in accounts whose user ID has a document in /volunteers (hub activity only).
    // Add people in the Firebase console: Firestore → admins or volunteers → Add document (ID = their user ID, field `name`).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isVolunteer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/volunteers/$(request.auth.uid));
    }

    function validGroup() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.points is number
        && (!('color' in d) || (d.color is string && d.color.size() <= 9));
    }

    function stationCount() {
      let path = /databases/$(database)/documents/meta/settings;
      return exists(path) ? get(path).data.get('stations', 8) : 8;
    }

    // A volunteer may record one hub station for one team: the delegates they ticked (hubPeople)
    // and the matching count (hub). The points must change by exactly what the hub formula gives,
    // and nothing else about the team can change.
    function validHubEntry() {
      let before = resource.data;
      let after = request.resource.data;
      let st = after.lastStation;
      let n = stationCount();
      let size = before.size;
      let c = after.hub[st];
      let o = before.get('hub', {}).get(st, 0);
      let people = after.hubPeople[st];
      return after.diff(before).affectedKeys().hasOnly(['hub', 'hubPeople', 'points', 'updatedAt', 'lastStation'])
        && st is string && st.matches('s[0-9]{1,2}')
        && int(st.replace('s', '')) >= 1 && int(st.replace('s', '')) <= n
        && after.hub.diff(before.get('hub', {})).affectedKeys().hasOnly([st])
        && after.hubPeople.diff(before.get('hubPeople', {})).affectedKeys().hasOnly([st])
        && people is list && people.size() == c
        && size is int && size > 0
        && c is int && c >= 0 && c <= size
        && o is int
        && math.abs(after.points - before.points - (c - o) * 1000.0 / (size * n)) < 0.01;
    }

    function validDelegate() {
      let d = request.resource.data;
      return d.groupId is string && d.groupId.size() > 0 && d.groupId.size() <= 100
        && d.first is string && d.first.size() <= 60
        && d.last is string && d.last.size() <= 60
        && (d.first.size() > 0 || d.last.size() > 0)
        && (!('link' in d) || (d.link is string && d.link.size() <= 500));
    }

    // Delegate names and fundraiser links are private: only organisers and volunteers can read them
    match /delegates/{delegateId} {
      allow read: if isAdmin() || isVolunteer();
      allow create, update: if isAdmin() && validDelegate();
      allow delete: if isAdmin();
    }

    // Public: anyone can read groups and board settings
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isAdmin() && validGroup();
      allow update: if (isAdmin() && validGroup()) || (isVolunteer() && validHubEntry());
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Change log: organisers and volunteers read it and add to it; only organisers delete
    match /log/{entryId} {
      allow read, create: if isAdmin() || isVolunteer();
      allow delete: if isAdmin();
    }

    // Each person may check only their own role record; nobody can write roles from the site
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /volunteers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
